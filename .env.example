# CybeWatch AI - Environment Configuration Example

# Project Settings
PROJECT_NAME="CybeWatch AI"
ENVIRONMENT="development"
DEBUG=True

# Authentication & Security
SECRET_KEY="change-me-to-a-secure-random-64-char-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for production, SQLite for local zero-config run)
# PostgreSQL: postgresql://username:password@localhost:5432/cybewatch_db
# SQLite: sqlite:///./cybewatch.db
DATABASE_URL="sqlite:///./cybewatch.db"

# AI Incident Investigator Settings
# Providers: local_deterministic (offline, zero-cost) | openai | gemini
LLM_PROVIDER="local_deterministic"
LLM_API_KEY=""

# Threat Alert Sensitivity Thresholds
THREAT_ALERT_THRESHOLD=0.50
CRITICAL_ALERT_THRESHOLD=0.85
HIGH_ALERT_THRESHOLD=0.70
MEDIUM_ALERT_THRESHOLD=0.50
